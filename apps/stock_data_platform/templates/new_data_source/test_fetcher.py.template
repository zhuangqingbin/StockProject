from __future__ import annotations

import pandas as pd

from apps.stock_data_platform.DataFetch.{{ fetcher_module_name }} import {{ FetcherClassName }}


def test_{{ fetcher_test_name }}_returns_dataframe_for_trade_date():
    calls: list[dict[str, str]] = []

    class FakeClient:
        pro = object()

        def call(self, endpoint: str, **kwargs):
            calls.append({"endpoint": endpoint, **kwargs})
            return pd.DataFrame(
                [
                    {
                        "trade_date": kwargs["trade_date"],
                        "{{ field_name_1 }}": "demo",
                    }
                ]
            )

    fetcher = {{ FetcherClassName }}(client=FakeClient())

    frame = fetcher.read_data(trade_date="20260315")

    assert calls == [
        {
            "endpoint": "{{ upstream_endpoint }}",
            "trade_date": "20260315",
            "fields": ",".join(fetcher.fields),
        }
    ]
    assert list(frame.columns)
